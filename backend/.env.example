SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-...
FRONTEND_URL=http://localhost:3000
OPENAI_MODEL=gpt-4o
# Optional — Jarvis external context (Google Calendar + Notion via Composio).
# Empty/unset: Jarvis behaves exactly as without this section.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
NOTION_TASKS_DATABASE_ID=

# Optional — Jarvis second-brain vault.
# VAULT_OWNER_USER_ID: Supabase user_id allowed to read the vault (and the
#   Composio calendar/notion/onedrive sources). Empty = gate denies everyone.
VAULT_OWNER_USER_ID=
# VAULT_SOURCE: "local" (default) reads VAULT_PATH from disk; "onedrive"
#   fetches allow-listed files live from OneDrive via Composio (for Render,
#   where no local vault folder exists). Reuses COMPOSIO_API_KEY/COMPOSIO_USER_ID.
VAULT_SOURCE=local
# Local source only — absolute path to the Obsidian vault folder.
VAULT_PATH=
# OneDrive source only — vault folder path relative to the drive root.
VAULT_ONEDRIVE_ROOT=/secondbrain
# OneDrive source only — in-memory snapshot cache TTL in seconds (default 600).
VAULT_ONEDRIVE_CACHE_TTL_SECONDS=600
